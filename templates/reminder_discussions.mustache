{{!
    @template local_edusupport/reminder_discussions

    The mail reminding a supporter of issues that wait for them.

    Context variables required for this template:
    * wwwroot The address of the site.
    * discussions The issues: id (of the discussion), name, userfullname and timemodified.

    Example context (json):
    {
        "wwwroot": "https://example.com",
        "discussions": [
            {
                "id": 12,
                "name": "Printer is broken",
                "userfullname": "Sally Student",
                "timemodified": 1757592000
            }
        ]
    }
}}

<!DOCTYPE html>
<html>
<head>
    <title>{{#str}} cron:reminder:title, local_edusupport {{/str}}</title>
</head>
<body>
<h3>{{#str}} cron:reminder:title, local_edusupport {{/str}}</h3>
<p>{{#str}} cron:reminder:intro, local_edusupport {{/str}}</p>
<ul>
    {{#discussions}}
        <li>
            {{userfullname}}: <a href="{{wwwroot}}/local/edusupport/issue.php?d={{id}}" target="_blank">{{name}}</a>,
            {{#userdate}} {{timemodified}}, %d. %B %Y, %H:%M {{/userdate}}
        </li>
    {{/discussions}}
</ul>
</body>
</html>
