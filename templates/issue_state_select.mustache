{{!
   @template local_edusupport/issue_state_select

   The select to change the status of an issue, used inside local_edusupport/issue_options.

   Classes required for JS:
   * changeStatusSelect

   Data attributes required for JS:
   * data-issueid

   Context variables required for this template:
   * id The id of the issue.

   Example context (json):
   {
       "id": 42
   }
 }}

<select id="local_edusupport_issue_state_select" class="changeStatusSelect form-select form-select-lg custom-select" data-issueid="{{id}}">
    <option selected disabled class="hideoption">-</option>
    <option value="1">{{#str}}status:notstarted, local_edusupport{{/str}}</option>
    <option value="2">{{#str}}status:awaitinguserreply, local_edusupport{{/str}}</option>
    <option value="3">{{#str}}status:ongoing, local_edusupport{{/str}}</option>
    <option value="4">{{#str}}status:awaitingsupportaction, local_edusupport{{/str}}</option>
</select>
