{{!
    @template local_edusupport/issues

    The issue list of the platform team, grouped by how the viewer is involved.

    Context variables required for this template:
    * count How many issues each group holds: current, assigned, other and closed.
    * current Issues the viewer is responsible for.
    * assigned Issues the viewer follows.
    * other All other open issues.
    * closed Closed issues.
    * wwwroot The address of the site.
    * sesskey The session key.
    * hasprio Whether issues have a priority.
    * userlinks Whether names link to profiles.
    * accountmanagerenabled Whether the account manager column is shown.
    * columncount How many columns the table has.

    Example context (json):
    {
        "count": {
            "current": 1,
            "assigned": 1,
            "other": 1,
            "closed": 1
        },
        "wwwroot": "https://example.com",
        "sesskey": "abc123",
        "hasprio": true,
        "userlinks": true,
        "accountmanagerenabled": true,
        "columncount": 6,
        "current": [
            {
                "id": 7,
                "discussionid": 21,
                "name": "Printer is broken",
                "prio": "",
                "userid": 5,
                "userfullname": "Sally Student",
                "accountmanager": 6,
                "accountmanagerfn": "Anna Account",
                "currentsupporterid": 4,
                "currentsupportername": "Sam Support",
                "lastpostuserid": 5,
                "lastpostuserfullname": "Sally Student",
                "lastmodified": 1757592000,
                "state": {
                    "class": "badge-info",
                    "stateclass": "notstarted",
                    "status": "Not yet started"
                },
                "priolow": "active",
                "priomid": "",
                "priohigh": ""
            }
        ],
        "assigned": [
            {
                "id": 8,
                "discussionid": 22,
                "name": "Mouse is stuck",
                "prio": "",
                "userid": 5,
                "userfullname": "Sally Student",
                "accountmanager": 6,
                "accountmanagerfn": "Anna Account",
                "currentsupporterid": 4,
                "currentsupportername": "Sam Support",
                "lastpostuserid": 5,
                "lastpostuserfullname": "Sally Student",
                "lastmodified": 1757592000,
                "state": {
                    "class": "badge-warning",
                    "stateclass": "ongoing",
                    "status": "Ongoing"
                },
                "priolow": "active",
                "priomid": "",
                "priohigh": ""
            }
        ],
        "other": [
            {
                "id": 9,
                "discussionid": 23,
                "name": "Screen stays black",
                "prio": "",
                "userid": 5,
                "userfullname": "Sally Student",
                "accountmanager": 6,
                "accountmanagerfn": "Anna Account",
                "currentsupporterid": 4,
                "currentsupportername": "Sam Support",
                "lastpostuserid": 5,
                "lastpostuserfullname": "Sally Student",
