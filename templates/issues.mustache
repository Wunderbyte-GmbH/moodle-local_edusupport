                            </a>
                        {{/userlinks}}
                        {{^userlinks}}
                            {{userfullname}}
                        {{/userlinks}}
                    </td>
                    {{#accountmanagerenabled}}
                    <td>
                        {{#accountmanager}}
                            {{#userlinks}}
                                <a href="{{wwwroot}}/user/view.php?id={{accountmanager}}">
                                    {{accountmanagerfn}}
                                </a>
                            {{/userlinks}}
                            {{^userlinks}}
                                {{accountmanagerfn}}
                            {{/userlinks}}
                        {{/accountmanager}}
                    </td>
                    {{/accountmanagerenabled}}
                    <td>
                        {{#userlinks}}
                            {{#currentsupporterid}}<a href="{{wwwroot}}/user/view.php?id={{currentsupporterid}}">{{/currentsupporterid}}
                            {{currentsupportername}}
                            {{#currentsupporterid}}</a>{{/currentsupporterid}}
                        {{/userlinks}}
                        {{^userlinks}}
                            {{currentsupportername}}
                        {{/userlinks}}
                    <br>
                        {{#userlinks}}
                            <a href="{{wwwroot}}/user/view.php?id={{lastpostuserid}}">
                                {{lastpostuserfullname}}
                            </a>
                        {{/userlinks}}
                        {{^userlinks}}
                                {{lastpostuserfullname}}
                        {{/userlinks}}
                    </td>
                    <td>
                            <span class="badge {{state.class}} position-static">{{state.status}}</span>
                            <br> {{#userdate}} {{lastmodified}}, %F %X {{/userdate}}
                    </td>
                    <td>
                        <a class="btn btn-outline-secondary" href="{{wwwroot}}/local/edusupport/issues.php?unassign={{discussionid}}&amp;sesskey={{sesskey}}" data-toggle="tooltip" data-placement="top" title="unsubscribe">
                            {{#pix}} i/show, core {{/pix}}
                        </a>
                        <a class="btn btn-outline-info" href="{{wwwroot}}/local/edusupport/issues.php?take={{discussionid}}&amp;sesskey={{sesskey}}" data-toggle="tooltip" data-placement="top" title="assign myself">
                            <i class="fa fa-plus" aria-hidden="true"></i>
                        </a>
                        <a class="btn btn-outline-info" href="{{wwwroot}}/local/edusupport/issues.php?asignto={{discussionid}}" onclick="require(['local_edusupport/main'], function(MAIN){ MAIN.assignSupporter({{discussionid}}); }); return false;" data-toggle="tooltip" data-placement="top" title="assign someone">
                            {{#pix}} i/enrolusers, core {{/pix}}
                        </a>
                        <a class="btn btn-outline-danger" href="{{wwwroot}}/local/edusupport/issues.php?close={{discussionid}}&amp;sesskey={{sesskey}}" data-toggle="tooltip" data-placement="top" title="close issue">
                            <i class="fa fa-window-close" aria-hidden="true"></i>
                        </a>
                        {{#hasprio}}
                        <div class="mt-2">
                        <a class="btn btn-outline-primary  {{priolow}}" href="{{wwwroot}}/local/edusupport/issues.php?prio={{discussionid}}&amp;lvl=1&amp;sesskey={{sesskey}}" data-toggle="tooltip" data-placement="top" title="priortiy low">
                        !
                        </a>
                        <a class="btn btn-outline-warning {{priomid}}" href="{{wwwroot}}/local/edusupport/issues.php?prio={{discussionid}}&amp;lvl=2&amp;sesskey={{sesskey}}"  data-toggle="tooltip" data-placement="top" title="priortiy mid">
                        !!
                        </a>
                        <a class="btn btn-outline-danger {{priohigh}}" href="{{wwwroot}}/local/edusupport/issues.php?prio={{discussionid}}&amp;lvl=3&amp;sesskey={{sesskey}}"  data-toggle="tooltip" data-placement="top" title="priortiy high">
                        !!!
                        </a>
                        </div>
                    {{/hasprio}}
                    </td>
                </tr>
            {{/assigned}}
            {{^assigned}}
            <tr>
                <td colspan="{{columncount}}">{{#str}} issues:assigned:none, local_edusupport {{/str}}</td>
            </tr>
            {{/assigned}}
            <tr>
                <th colspan="{{columncount}}">{{#str}} issues:other, local_edusupport {{/str}}</th>
            </tr>
            {{#other}}
                <tr class="issue {{state.stateclass}}">
                    <td>
                         {{{prio}}}
                        <a href="{{wwwroot}}/local/edusupport/issue.php?d={{discussionid}}">
                            {{id}}
                        </a>
                    </td>
                    <td>
                        <a href="{{wwwroot}}/local/edusupport/issue.php?d={{discussionid}}">
                            {{name}}
                        </a>
                        <br>
                        <span>{{#str}} startedby, local_edusupport {{/str}} :</span>{{#userlinks}}
                            <a href="{{wwwroot}}/user/view.php?id={{userid}}">
                                {{userfullname}}
                            </a>
                        {{/userlinks}}
                        {{^userlinks}}
