{{!
    @template local_edusupport/course_supporters

    The people who support this course.

    Context variables required for this template:
    * courseid - id of the course
    * supporters - array of userid, fullname, email, profileurl
    * hassupporters - whether anybody is assigned
    * issupportcourse - whether the course holds a support forum at all

    Example context (json):
    {
        "courseid": 2,
        "hassupporters": true,
        "issupportcourse": true,
        "supporters": [
            {"userid": 5, "fullname": "Sam Support", "email": "sam@example.com", "profileurl": "#"}
        ]
    }
}}
<div class="local_edusupport coursesupporters" data-region="coursesupporters" data-courseid="{{courseid}}">
    {{^issupportcourse}}
        <div class="alert alert-info" role="status">
            {{#str}} coursesupporters:nosupportforum, local_edusupport {{/str}}
        </div>
    {{/issupportcourse}}

    {{#hassupporters}}
        <table class="generaltable w-100">
            <thead>
                <tr>
                    <th scope="col">{{#str}} name {{/str}}</th>
                    <th scope="col">{{#str}} email {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#supporters}}
                    <tr>
                        <td><a href="{{profileurl}}">{{fullname}}</a></td>
                        <td>{{email}}</td>
                    </tr>
                {{/supporters}}
            </tbody>
        </table>
    {{/hassupporters}}

    {{^hassupporters}}
        <div class="alert alert-warning" role="status">
            {{#str}} coursesupporters:none, local_edusupport {{/str}}
        </div>
    {{/hassupporters}}
</div>
