{{!
    @template local_edusupport/chooseforum

    The forums of a course, to pick which of them are support forums.

    Context variables required for this template:
    * wwwroot The address of the site.
    * sesskey The session key.
    * forums The forums of the course: id, course, name, state (is a support forum), statecentral (is the central one) and supporters to pick the dedicated supporter from (userid, supportlevel, userfullname, email, selected).

    Example context (json):
    {
        "wwwroot": "https://example.com",
        "sesskey": "abc123",
        "forums": [
            {
                "id": 3,
                "course": 2,
                "name": "Announcements",
                "state": false,
                "statecentral": false
            },
            {
                "id": 4,
                "course": 2,
                "name": "Support forum",
                "state": true,
                "statecentral": true,
                "supporters": [
                    {
                        "userid": 5,
                        "supportlevel": "2nd level support",
                        "userfullname": "Sam Support",
                        "email": "sam@example.com",
                        "selected": true
                    }
                ]
            }
        ]
    }
}}
<div class="local_edusupport chooseforum">
    <table class="generaltable w-100">
        <thead>
            <tr>
                <td style="width: 250px">{{#str}} toggle, local_edusupport {{/str}}</td>
                <td style="width: 250px">{{#str}} toggle:central, local_edusupport {{/str}}</td>
                <td>{{#str}} name {{/str}}</td>
                <td style="width: 150px">{{#str}} dedicatedsupporter, local_edusupport {{/str}}</td>
            </tr>
        </thead>
        <tbody>
            {{#forums}}
                <tr>
                    <td>
                        {{^state}}
                            <a href="{{wwwroot}}/local/edusupport/chooseforum.php?courseid={{course}}&amp;forumid={{id}}&amp;state=1&amp;sesskey={{sesskey}}"
                                class="btn btn-block btn-secondary">
                                {{#str}} supportforum:enable, local_edusupport {{/str}}
                            </a>
                        {{/state}}
                        {{#state}}
                        <a href="{{wwwroot}}/local/edusupport/chooseforum.php?courseid={{course}}&amp;forumid={{id}}&amp;state=-1&amp;sesskey={{sesskey}}"
                            class="btn btn-block btn-primary">
                            {{#str}} supportforum:disable, local_edusupport {{/str}}
                        </a>
                        {{/state}}
                    </td>
                    <td>
                        {{^state}}
                            -
                        {{/state}}
                        {{#state}}
                            {{^statecentral}}
                                <a href="{{wwwroot}}/local/edusupport/chooseforum.php?courseid={{course}}&amp;forumid={{id}}&amp;central=1&amp;sesskey={{sesskey}}"
                                    class="btn btn-block btn-primary">
                                    {{#str}} supportforum:central:enable, local_edusupport {{/str}}
                                </a>
                            {{/statecentral}}
                            {{#statecentral}}
                                <a href="{{wwwroot}}/local/edusupport/chooseforum.php?courseid={{course}}&amp;forumid={{id}}&amp;central=-1&amp;sesskey={{sesskey}}"
                                    class="btn btn-block btn-primary">
                                    {{#str}} supportforum:central:disable, local_edusupport {{/str}}
                                </a>
                            {{/statecentral}}
                        {{/state}}
                    </td>
                    <td>{{name}}</td>
                    <td>
                        {{^state}}
                            -
                        {{/state}}
                        {{#state}}
                        <select name="setsupporter_{{uniqid}}_{{id}}" onchange="top.location.href='{{wwwroot}}/local/edusupport/chooseforum.php?courseid={{course}}&amp;forumid={{id}}&amp;dedicatedsupporter=' + this.value + '&amp;sesskey={{sesskey}}';">
                            <option value="-1">{{#str}} none {{/str}}</option>
                            {{#supporters}}
                            <option value="{{userid}}"{{#selected}} selected="selected" {{/selected}}>
                                {{supportlevel}}:
                                {{userfullname}} ({{email}})
                            </option>
                            {{/supporters}}
                        </select>
                        {{/state}}
                    </td>
                </tr>
            {{/forums}}
        </tbody>
    </table>
</div>
