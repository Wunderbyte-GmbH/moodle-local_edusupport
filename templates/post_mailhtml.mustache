{{!
    @template local_edusupport/post_mailhtml

    The html mail telling a subscriber about a new post in an issue.

    Context variables required for this template:
    * authorpicture The picture of the author, as HTML.
    * subject The subject of the post.
    * authorlink The profile address of the author.
    * authorfullname The name of the author.
    * postdate When the post was written.
    * grouppicture The picture of the group, as HTML, if any.
    * attachments The attachments, as HTML, if any.
    * message The post, as HTML.
    * issuelink The address of the issue.
    * replylink The address to reply at.

    Example context (json):
    {
        "authorpicture": "<img src=\"https://example.com/pix/u/f2.png\" alt=\"Sally Student\" width=\"35\" height=\"35\">",
        "subject": "Printer is broken",
        "authorlink": "https://example.com/user/view.php?id=5",
        "authorfullname": "Sally Student",
        "postdate": "11. September 2026, 15:30",
        "grouppicture": "",
        "attachments": "",
        "message": "<p>The printer in room 12 does not print.</p>",
        "issuelink": "https://example.com/local/edusupport/issue.php?d=12",
        "replylink": "https://example.com/local/edusupport/issue.php?d=12&replyto=34"
    }
}}

<table class="forumpost" style="border: 0; border-collapse: collapse;">
    <tr class="header">
        <td class="picture left" style="width: 35px; padding: 3px; vertical-align: top;">
            {{{ authorpicture }}}
        </td>
        <td class="topic" style="padding: 3px;">
            <div class="subject">
                {{{ subject }}}
            </div>
            <div class="author">
                {{# str }} bynameondate, forum, {
                        "name": {{# quote }}<a target='_blank' href='{{{ authorlink }}}'>{{ authorfullname }}</a>{{/ quote }},
                        "date": {{# quote }}{{ postdate }}{{/ quote }}
                    } {{/ str }}
            </div>
        </td>
    </tr>
    <tr>
        <td class="left side" style="padding: 3px; vertical-align: top;">
            {{# grouppicture }}
                {{{ grouppicture }}}
            {{/ grouppicture }}
            {{^ grouppicture }}
                &nbsp;
            {{/ grouppicture }}
        </td>
        <td class="content" style="padding: 3px;">
            {{# attachments }}
                <div class="attachments">
                    {{{ attachments }}}
                </div>
            {{/ attachments }}
            {{{ message }}}

            <div class="commands">
                <a target="_blank" href="{{{ issuelink }}}">
                    {{# str }} parent, forum {{/ str }}
                </a>
                    |
                <a target="_blank" href="{{{ replylink }}}">
                    {{# str }} reply, forum {{/ str }}
                </a>
            </div>
        </td>
    </tr>
</table>
