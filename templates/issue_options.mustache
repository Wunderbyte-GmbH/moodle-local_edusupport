{{!
   @template local_edusupport/issue_options

   The purpose of this template is to render action buttons for issues.

   Classes required for JS:
   * none

   Data attributes required for JS:
   * none

   Context variables required for this template:
   * options List of buttons, each with title and optionally class, icon, href and onclick.
     An option without href is shown as a label instead of a button.
   * changestatus Whether to show the select to change the status.
   * id The id of the issue, needed when changestatus is set.

   Example context (json):
   {
       "options": [
           {
               "title": "Sam Support (2nd level support)",
               "class": "",
               "href": "https://example.com/user/profile.php?id=2"
           },
           {
               "title": "Ongoing",
               "class": "alert-warning"
           },
           {
               "title": "Assign",
               "class": "btn-secondary",
               "icon": "i/assignroles",
               "href": "#"
           }
       ],
       "changestatus": true,
       "id": 42
   }
 }}
<div class="local_edusupport issue_options" style="float: right;">
    {{#options}}
        {{#href}}
            <a href="{{href}}"
               class="btn {{#class}} {{class}} {{/class}}"
                {{#onclick}} onclick="{{onclick}}" {{/onclick}}>
                {{#icon}} {{#pix}} {{icon}} {{/pix}} {{/icon}}
                {{title}}
            </a>
        {{/href}}
        {{^href}}
            <span class="alert {{#class}} {{class}} {{/class}}"
                {{#onclick}} onclick="{{onclick}}" {{/onclick}}>
                {{#icon}} {{#pix}} {{icon}} {{/pix}} {{/icon}}
                {{title}}
            </span>
        {{/href}}
    {{/options}}
    {{#changestatus}}
        <div class="d-inline-block">
            <div class="input-group">
                <div class="input-group-prepend">
                    <label class="input-group-text" for="local_edusupport_issue_state_select">{{#str}} changestatus, local_edusupport {{/str}}</label>
                </div>
                {{> local_edusupport/issue_state_select }}
            </div>
        </div>
    {{/changestatus}}
</div>
{{#changestatus}}
    {{#js}}
        require(['local_edusupport/issues'], function(issues) {
        issues.init();
        });
    {{/js}}
{{/changestatus}}
